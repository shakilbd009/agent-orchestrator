backend/tmp/
frontend/tmp/
frontend/.svelte-kit/

# Dependency caches
backend/vendor/
frontend/node_modules/

# Environment secrets (never commit)
.env
.env.local
.env.*.local
.env.*

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Docker volumes
*.vol

# Keep empty directories
!backend/.gitkeep
!frontend/.gitkeep
